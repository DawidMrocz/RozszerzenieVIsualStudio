			<IDSymbol name="GenerateEmptyRepository" value="0x0480" />
			<IDSymbol name="GenerateResponseFromSql" value="0x0490" />
			<IDSymbol name="GenerateIntegrationTest" value="0x0510" />
			<!-- Quick Actions Symbols -->

			<!-- Build Symbols -->
			<IDSymbol name="MroczwareBuildGroup" value="0x0600" />
			<IDSymbol name="ResetIis" value="0x0610" />
			<IDSymbol name="ViewLogs" value="0x0620" />
			<!-- Build Symbols -->

			<!-- Solution Explorer -->
			<IDSymbol name="MroczwareSolutionExplorerGroup" value="0x0800" />
			<IDSymbol name="MroczwareFolderGroup" value="0x0900" />
			<!-- Build Symbols -->

		</GuidSymbol>
		<GuidSymbol name="MroczwareIcon" value="{11E1E337-6574-47BD-B71F-347631E2B76C}">
