<Window x:Class="Mroczware.PowerFullTool.UI.View.GenerateSqlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wybierz tabelę"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
         Width="Auto"
        Height="Auto"
        SizeToContent="WidthAndHeight"
        BorderBrush="#7160E8" 
        BorderThickness="1"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/DarkButton.xaml"/>
                <ResourceDictionary Source="../Styles/DarkTextBox.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="#242424">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- LEWA STRONA -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock HorizontalAlignment="Center" Text="Wybierz wstępny szablon SQL" FontSize="18" FontWeight="Regular" Foreground="Wheat" Margin="0 10 0 10"/>
                <ComboBox Width="280" Margin="10,5" HorizontalAlignment="Center"
                          ItemsSource="{Binding ActionKeys}"
                          SelectedItem="{Binding ActionKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <Separator Margin="20" Background="Gray" Height="1"/>
            </StackPanel>

            <StackPanel Grid.Row="1">
                <TextBlock HorizontalAlignment="Center" Text="Wpisz nazwę akcji" FontSize="18" FontWeight="Regular" Foreground="Wheat" Margin="0 0 0 10"/>
                <TextBox Width="260" Margin="0 0 0 10" Height="34" Background="#3C3C3C" Foreground="Wheat"
                         BorderThickness="0" BorderBrush="Transparent"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Text="{Binding ActionText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         TextAlignment="Left" VerticalContentAlignment="Center" Padding="5,0"
                         FontWeight="Light" FontSize="18"/>
                <CheckBox Content="Przekaż treść zapytania do schowka"
                          IsChecked="{Binding CopyToClipboard, Mode=TwoWay}"
                          HorizontalAlignment="Center"
                          Foreground="Wheat"
                          FontSize="14"
                          Margin="0,5,0,5"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,10">
                <Button Content="Wybierz" Margin="5" Style="{StaticResource DarkVioletButton}" Click="Wybierz_Click"/>
                <Button Content="Anuluj" Margin="5" Style="{StaticResource DarkBasicButton}" Click="Anuluj_Click"/>
            </StackPanel>
        </Grid>

        <!-- PRAWA STRONA - lista checkboxów -->
        <StackPanel Grid.Column="1" Margin="10" Visibility="{Binding ShowReferencedTables, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Dodaj JOIN'y dla (opcjonalnie)"
               FontSize="18"
               FontWeight="Regular"
               Foreground="Wheat"
               Width="400"
               HorizontalAlignment="Center"
               Margin="0,0,0,10"/>

            <Border BorderBrush="#444" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Height="180">
                    <ItemsControl ItemsSource="{Binding ReferencedTableList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="10*"/>
                                        <ColumnDefinition Width="70*"/>
                                        <ColumnDefinition Width="30*"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ReferencedName}" Foreground="White" HorizontalAlignment="Left"/>
                                    <TextBlock Grid.Column="3" Text="{Binding TypeOfJoin}" Foreground="White" HorizontalAlignment="Left"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </StackPanel>
    </Grid>
</Window>