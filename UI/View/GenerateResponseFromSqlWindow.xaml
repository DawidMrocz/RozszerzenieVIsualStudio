<Window x:Class="Mroczware.PowerFullTool.UI.View.GenerateResponseFromSqlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="Panel SQL / Tabele"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Width="900" Height="1000"
        BorderBrush="#7160E8"
        BorderThickness="1"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/DarkButton.xaml"/>
                <ResourceDictionary Source="../Styles/DarkTextBox.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="#242424">

        <!-- Główna siatka: nagłówek + taby + przyciski -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Nagłówek -->
            <RowDefinition Height="*"/>
            <!-- TabControl -->
            <RowDefinition Height="Auto"/>
            <!-- Przyciski -->
        </Grid.RowDefinitions>

        <!-- 🟢 Nagłówek -->
        <TextBlock Grid.Row="0"
                   Text="Wygeneruj obiekt odpowiedzi"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Foreground="Wheat"
                   HorizontalAlignment="Center"
                   Margin="0,15,0,10"/>

        <!-- 🟣 TAB CONTROL -->
        <Border Grid.Row="1" BorderBrush="#444" Margin="10,0,10,10">
            <Grid Background="#242424">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Nagłówek -->
                    <RowDefinition Height="*"/>
                    <!-- TabControl -->
                    <RowDefinition Height="Auto"/>
                    <!-- Przyciski -->
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Vertical" HorizontalAlignment="Center" Margin="0,10,0,10">
                    <TextBlock HorizontalAlignment="Center" 
       Text="Podaj nazwę klasy" 
       FontSize="18" Foreground="Wheat" Margin="10"/>
                    <TextBox Width="250" Height="24" Foreground="White" Background="#383838"
     Text="{Binding ClassNameText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                </StackPanel>

                <TabControl Grid.Row="1"  Background="#242424" 
               Foreground="White" 
               SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
               BorderThickness="1" BorderBrush="#444">

                    <!-- 🟢 ZAKŁADKA 1: SQL Editor -->
                    <TabItem Header="SQL Editor">

                        <Grid Background="#242424" Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Vertical" HorizontalAlignment="Center" Margin="0,10,0,10">
                                <TextBlock HorizontalAlignment="Center" 
                       Text="Wklej zapytanie SELECT:" 
                       FontSize="18" Foreground="Wheat" Margin="10"/>
                            </StackPanel>

                            <TextBox Grid.Row="1" AcceptsReturn="True" 
                                AcceptsTab="True" 
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Auto"
                                FontFamily="Consolas" 
                                FontSize="14" 
                                Background="#444"
                                Foreground="AliceBlue"
                                CaretBrush="White"
                                SelectionBrush="#444"
                                SelectionOpacity="0.7"
                                BorderBrush="#444"
                                Text="{Binding SqlQuery, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </TabItem>

                    <!-- 🟣 ZAKŁADKA 2: Procedury, funkcje tabelaryczne, RESX -->
                    <TabItem Header="Procedury / Funkcje / Tabele">
                        <Grid Background="#242424" Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Vertical" HorizontalAlignment="Center" Margin="0,10,0,10">
                                <TextBlock HorizontalAlignment="Center" 
                              Text="Wyszukaj procedurę, funkcję tabelaryczną lub tabelę:" 
                              FontSize="18" Foreground="Wheat" Margin="10"/>
                                <TextBox Width="250" Height="24" Foreground="White" Background="#383838"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                            </StackPanel>

                            <Border Grid.Row="1" BorderBrush="#444" BorderThickness="1" Margin="10">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding FilteredItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="5*"/>
                                                        <ColumnDefinition Width="25*"/>
                                                        <ColumnDefinition Width="30*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox Grid.Column="0"
                                             IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Command="{Binding DataContext.SelectTableCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                             CommandParameter="{Binding}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Key}" Foreground="White"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Value}" Foreground="White"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
           
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,10">
            <Button Content="Wybierz" Margin="5" Style="{StaticResource DarkVioletButton}" Click="Wybierz_Click"/>
            <Button Content="Anuluj" Margin="5" Style="{StaticResource DarkBasicButton}" Click="Anuluj_Click"/>
        </StackPanel>
    </Grid>
</Window>
