<Window x:Class="Mroczware.PowerFullTool.UI.View.LogsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wybierz tabelę"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Width="800" Height="400"
        BorderBrush="#7160E8" 
        BorderThickness="1"
        WindowStartupLocation="CenterScreen"
        MouseLeftButtonDown="MoveWindow">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/DarkButton.xaml"/>
                <ResourceDictionary Source="../Styles/DarkTextBox.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="#242424">

        <Grid Margin="0,5,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Vertical" HorizontalAlignment="Center" Margin="0,10,0,10">
                <TextBlock  HorizontalAlignment="Center" Text="Znaleziono kilka zaktualizowanych plików Logs" FontSize="18"  FontWeight="Regular" Foreground="Wheat" Margin="10"/>
            </StackPanel>

            <Border Grid.Row="1" BorderBrush="#444" BorderThickness="1" Margin="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding FilteredTables}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="750"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Command="{Binding DataContext.SelectTableCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                              CommandParameter="{Binding}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="White" HorizontalAlignment="Left"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
                <Button Content="Wybierz" Margin="5" Style="{StaticResource DarkVioletButton}" Command="{Binding ConfirmSelectionCommand}"/>
                <Button Content="Anuluj" Margin="5" Style="{StaticResource DarkBasicButton}" Command="{Binding CloseWindowCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

