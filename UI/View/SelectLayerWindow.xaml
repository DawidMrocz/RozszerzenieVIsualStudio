<Window x:Class="Mroczware.PowerFullTool.UI.View.SelectLayerWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Wybierz tabelę"
 WindowStyle="None"
 AllowsTransparency="True"
 Background="Transparent"
 ResizeMode="NoResize"
 Width="300" Height="260"
 BorderBrush="#7160E8" 
 BorderThickness="1"
 WindowStartupLocation="CenterScreen">


    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/DarkButton.xaml"/>
                <ResourceDictionary Source="../Styles/DarkTextBox.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="#242424">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="10">
            <TextBlock  HorizontalAlignment="Center" Text="Wybierz stopień generowania:" FontSize="18"  FontWeight="Regular" Foreground="Wheat" Margin="10"/>

            <TextBlock  HorizontalAlignment="Center" Text="Uwaga! Nadpisuje pliki." FontSize="14"  FontWeight="Regular" Foreground="Wheat" Margin="0 0 0 10"/>

            <RadioButton Content="Kontroler, Serwis, Repozytorium" FontSize="14" Foreground="White" Background="Wheat" Margin="5" GroupName="ServiceGroup" Tag="Controllers_Services_Repositories" Checked="RadioButton_Checked" IsChecked="True"/>
            <RadioButton Content="Serwis, Repozytorium" FontSize="14" Foreground="White" Background="Wheat" Margin="5" GroupName="ServiceGroup" Tag="Services_Repositories" Checked="RadioButton_Checked"/>
            <RadioButton Content="Repozytorium" FontSize="14" Foreground="White" Background="Wheat" Margin="5" GroupName="ServiceGroup" Tag="Repositories" Checked="RadioButton_Checked"/>

            <CheckBox x:Name="CheckBoxAsynchronous" Content="Generuj asynchroniczne akcje" Tag="CheckBoxAsynchronous" Foreground="White" Background="#3C3C3C" Margin="5" Grid.Row="0" Grid.Column="0"
                Checked="CheckBoxAsynchronous_Checked" Unchecked="CheckBoxAsynchronous_Unchecked"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,10">
            <Button Content="Anuluj" Margin="5" Style="{StaticResource DarkBasicButton}" Click="Anuluj_Click"/>
            <Button Content="Wybierz" Margin="5" Style="{StaticResource DarkVioletButton}" Click="Wybierz_Click"/>
        </StackPanel>

    </Grid>
</Window>

