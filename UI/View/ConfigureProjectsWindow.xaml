<Window x:Class="UI.View.ConfigureProjectsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wybierz tabelę"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Width="400" Height="430"
        BorderBrush="#403582" 
        BorderThickness="0.5"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/DarkButton.xaml"/>
                <ResourceDictionary Source="../Styles/DarkTextBox.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="ComboBox">
                <Setter Property="FontSize" Value="14"/>
            </Style>
        </ResourceDictionary>
        
    </Window.Resources>

    <!-- Główne tło w ciemnym stylu -->
    <Grid Background="#252526">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border BorderBrush="#3C3C3C" Background="Transparent" Grid.Row="0">
            <StackPanel Background="Transparent">

                <TextBlock Text="Nie udało się wywnioskować wszystkich parametrów" Margin="5,5,0,5" FontSize="16" Foreground="White" HorizontalAlignment="Center"/>

                <TextBlock Text="Ustaw connection string" Margin="5,5,0,5" FontSize="16" Foreground="White" HorizontalAlignment="Center"/>
                <Separator Background="#403582" Height="1" Width="170"/>

                <!--<TextBox x:Name="ConnectionStringTextBox" Margin="0,15,0,0" Grid.Row="1" Width="350" />-->

                <ComboBox Width="auto" Margin="10,5"
                     ItemsSource="{Binding ConnectionStringKeys}"
                     SelectedItem="{Binding ConnectionStringText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Ustaw projekty i foldery" Margin="5,15,0,5" FontSize="16" Foreground="White" HorizontalAlignment="Center"/>
                <Separator Background="#403582" Height="1" Width="170"/>

                <StackPanel Margin="5">
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="25" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Warstwa Api" Foreground="White" Margin="5" HorizontalAlignment="Center" Grid.Column="1"/>
                        <TextBlock Text="Folder dla ApiModels" Foreground="White" Margin="5" HorizontalAlignment="Center" Grid.Column="2"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Content="✖" Width="25" Height="25"
                                Command="{Binding ClearApiSelectionCommand}"
                                Grid.Column="0"/>

                        <ComboBox Width="160" Margin="10,5"
                                  ItemsSource="{Binding ProjectKeys}"
                                  SelectedItem="{Binding ApiSelectedProject, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  HorizontalContentAlignment="Center"
                                  MaxDropDownHeight="800" 
                                  Grid.Column="1"/>


                        <ComboBox Width="160" Margin="10,5"
                                  ItemsSource="{Binding FoldersApiKeys}"
                                  SelectedItem="{Binding ApiText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Grid.Column="2"/>
                    </Grid>
                </StackPanel>

                <StackPanel Margin="5">
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="25" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Warstwa Core" Foreground="White" Margin="5" HorizontalAlignment="Center" Grid.Column="1"/>
                        <TextBlock Text="Folder dla DTO" Foreground="White" Margin="5" HorizontalAlignment="Center" Grid.Column="2"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Content="✖" Width="25" Height="25"
                                Command="{Binding ClearCoreSelectionCommand}"
                                Grid.Column="0"/>

                        <ComboBox Width="160" Margin="10,5" 
                                  ItemsSource="{Binding ProjectKeys}"
                                  SelectedItem="{Binding CoreSelectedProject, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  HorizontalContentAlignment="Center"
                                  Grid.Column="1"/>

                        <ComboBox Width="160" Margin="10,5"
                                  ItemsSource="{Binding FoldersCoreKeys}"
                                  SelectedItem="{Binding CoreText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Grid.Column="2"/>
                    </Grid>
                </StackPanel>

                <StackPanel Margin="5">
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="25" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Warstwa Data" Foreground="White" Margin="5" HorizontalAlignment="Center" Grid.Column="1"/>
                        <TextBlock Text="Folder dla Modeli" Foreground="White" Margin="5" HorizontalAlignment="Center" Grid.Column="2"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Content="✖" Width="25" Height="25"
                                Command="{Binding ClearDataSelectionCommand}"
                                Grid.Column="0"/>

                        <ComboBox Width="160" Margin="10,5"
                                  ItemsSource="{Binding ProjectKeys}"
                                  SelectedItem="{Binding DataSelectedProject, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  HorizontalContentAlignment="Center"
                                  Grid.Column="1"/>

                        <ComboBox Width="160" Margin="10,5"
                                  ItemsSource="{Binding FoldersDataKeys}"
                                  SelectedItem="{Binding DataText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Grid.Column="2"/>
                    </Grid>
                </StackPanel>

            </StackPanel>
        </Border>

        <!-- 🔹 Przyciski na samym dole -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Content="Reset" Style="{StaticResource DarkBasicButton}" Margin="10" Click="ClearSettings"/>
            <Button Content="Anuluj" Style="{StaticResource DarkBasicButton}" Margin="10" Click="CloseWindow"/>
            <Button Content="Dalej" Style="{StaticResource DarkVioletButton}" Margin="10" Click="SaveSettings"/>
        </StackPanel>

    </Grid>

</Window>

