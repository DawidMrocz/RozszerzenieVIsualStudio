    <Metadata>
        <Identity Id="MroczwareTools.3d3ab221-7d09-46b8-b560-5f437404da88" Version="1.0" Language="en-US" Publisher="Dawid Mroczkowski" />
        <DisplayName>MroczwareTools</DisplayName>
